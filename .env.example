# ZYVO Environment Configuration Template
# Place real private keys in .env.local (strictly git-ignored)

# Server port and host
PORT=3000
HOST=localhost

# Security Secrets (Generate random 32+ char secrets for production)
SESSION_SECRET=zyvo_dev_session_secret_key_change_in_production
ADMIN_SECRET=zyvo_dev_admin_purge_secret_key_change_in_production

# External API Activation Guard (Set to true only when real credentials are provided)
EXTERNAL_API_ENABLED=false

# Indic Speech-to-Text Providers
SARVAM_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=

# Provider Routing Preferences
STT_PRIMARY_PROVIDER=sarvam
STT_FALLBACK_PROVIDERS=groq,mock

INTENT_PRIMARY_PROVIDER=gemini
INTENT_FALLBACK_PROVIDER=deterministic

# Database File Path (Default: local host persistent storage)
DATABASE_PATH=zyvo.db
